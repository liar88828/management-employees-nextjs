model Employees {
  id             String       @id @default(uuid()) // Primary key with auto-increment
  // userName            String
  // email           String            @unique
  // phone           String
  /// @zod.min(1)
  gender         String // Gender (e.g., "Male", "Female", "Other")
  dateOfBirth    DateTime
  hireDate       DateTime
  /// @zod.min(1)
  jobTitle       String // Employee's job position
  /// @zod.min(1)
  salary         Int // Employee's salary
  // managerId      Int? // Foreign key referencing the manager
  /// @zod.min(1)
  statusEmployee String       @default("Create") // Employment statusEmployee
  registration   Boolean      @default(false) // Employment statusEmployee
  /// @zod.min(1)
  address        String
  /// @zod.min(1)
  city           String // City where the employee lives
  /// @zod.min(1)
  postalCode     String // Postal/ZIP code
  /// @zod.min(1)
  workTime       String // Work Time (e.g., "Full-Time", "Part-Time")
  /// @zod.min(1)
  notes          String // Additional notes about the employee
  /// @zod.min(1)
  img            String
  sendEmail      Int          @default(0)
  //
  // country        String
  Educations     Educations[]
  Skills         Skills[] // Stored as an lists of strings
  //
  photoKtp       String?
  photoIjazah    String?
  User           Users        @relation(fields: [userId], references: [id])
  userId         String       @unique
  //
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // ImageAES     ImageAES     @relation(fields: [imageAESId], references: [id])
  // imageAESId   Int          @unique
}

