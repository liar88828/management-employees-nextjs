model Employees {
  id          String   @id @default(uuid()) /// @zod.uuid().optional()
  /// @zod.min(1)
  gender      String // Gender (e.g., "Male", "Female", "Other")
  dateOfBirth DateTime
  hireDate    DateTime
  /// @zod.min(1)
  jobTitle    String // Employee's job position

  /// @zod.min(1)
  statusEmployee String       @default("Create") // Employment statusEmployee
  registration   Boolean      @default(false) // Employment statusEmployee
  address        String /// @zod.min(1)
  city           String /// @zod.min(1)
  postalCode     String /// @zod.min(1)
  /// @zod.min(1)
  workTime       String // Work Time (e.g., "Full-Time", "Part-Time")
  /// @zod.min(0)
  notes          String // Additional notes about the employee
  /// @zod.min(0)
  salary         Int
  //
  Educations     Educations[]
  Skills         Skills[] // Stored as an lists of strings
  //
  User           Users        @relation(fields: [userId], references: [id])
  userId         String       @unique

  ImageEmployee ImageEmployee?
  //
  createdAt     DateTime       @default(now()) /// @zod.optional()
  updatedAt     DateTime       @updatedAt /// @zod.optional()
}

model ImageEmployee {
  /// @zod.optional()
  id             Int       @id() @default(autoincrement())
  photoProfile   String?
  photoSignature String?
  photoKtp       String?
  photoIjazah    String?
  Employees      Employees @relation(fields: [employeeId], references: [id])
  employeeId     String    @unique
}

model Educations {
  /// @zod.optional()
  id         Int       @id @default(autoincrement())
  /// @zod.min(1)
  text       String
  /// @zod.min(1)
  employeeId String
  Employees  Employees @relation(fields: [employeeId], references: [id])
}

model Skills {
  /// @zod.optional()
  id         Int       @id @default(autoincrement())
  /// @zod.min(1)
  text       String
  /// @zod.min(1)
  employeeId String
  Employees  Employees @relation(fields: [employeeId], references: [id])
}
