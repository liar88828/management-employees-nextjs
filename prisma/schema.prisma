//   id        String   @id @default(uuid())
//   usersId   String   @unique
//   expiresAt DateTime
//   role      String
//   Users     Users    @relation(fields: [usersId], references: [id])
// }

model Employees {
	id          String   @id @default(uuid())
	/// @zod.string.min(1)
	gender      String // Gender (e.g., "Male", "Female", "Other")
	dateOfBirth DateTime
	hireDate    DateTime
	/// @zod.string.min(1)
	jobTitle    String // Employee's job position

	/// @zod.string.min(1)
	statusEmployee String        @default("Create") // Employment statusEmployee
	registration   Boolean       @default(false) // Employment statusEmployee
	address        String /// @zod.string.min(1)
	city           String /// @zod.string.min(1)
	postalCode     String /// @zod.string.min(1)
	/// @zod.string.min(1)
	workTime       String // Work Time (e.g., "Full-Time", "Part-Time")
	/// @zod.string.min(0)
	notes          String // Additional notes about the employee
	/// @zod.number.min(0)
	salary         Int
	//
	Educations     Educations[]
	Skills         Skills[] // Stored as an lists of strings
	Experiences    Experiences[]

	//
	User   Users  @relation(fields: [userId], references: [id])
	userId String @unique

	ImageEmployee ImageEmployee?
	//
	createdAt     DateTime       @default(now())
	updatedAt     DateTime       @updatedAt
}

model ImageEmployee {
	// @zod.number.optional()
	id             Int       @id() @default(autoincrement())
	photoProfile   String?
	photoSignature String?
	photoKtp       String?
	photoIjazah    String?
	Employees      Employees @relation(fields: [employeeId], references: [id])
	employeeId     String    @unique
}

model Educations {
	// @zod.number.optional()
	id         Int       @id @default(autoincrement())
	/// @zod.string.min(1)
	text       String
	/// @zod.string.min(1)
	employeeId String
	Employees  Employees @relation(fields: [employeeId], references: [id])
}

model Skills {
	// @zod.number.optional()
	id         Int       @id @default(autoincrement())
	/// @zod.string.min(1)
	text       String
	/// @zod.string.min(1)
	employeeId String
	Employees  Employees @relation(fields: [employeeId], references: [id])
}

model Experiences {
	// @zod.number.optional()
	id         Int       @id @default(autoincrement())
	/// @zod.string.min(1)
	text       String
	/// @zod.string.min(1)
	employeeId String
	Employees  Employees @relation(fields: [employeeId], references: [id])
}
