model Educations {
  id         Int       @id @default(autoincrement())
  /// @zod.min(1)
  text       String
  /// @zod.min(1)
  employeeId String
  Employees  Employees @relation(fields: [employeeId], references: [id])
}

model Skills {
  id         Int       @id @default(autoincrement())
  /// @zod.min(1)
  text       String
  /// @zod.min(1)
  employeeId String
  Employees  Employees @relation(fields: [employeeId], references: [id])
}
